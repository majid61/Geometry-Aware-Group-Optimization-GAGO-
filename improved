% GAGO Framework: Geometry-Aware Group Optimization
% Corrected & Cleaned Version: Fair comparison with Gradient Methods

clear; clc; close all;

%% Experimental Setup
d = 10;
max_FE = 5000;
benchmarks = {'Sphere', 'Rosenbrock', 'Rastrigin', 'Ackley', 'Griewank', 'Schwefel'};
baselines = {'GD', 'Adam', 'RMSprop', 'GAGO'};

results_final = zeros(length(benchmarks), length(baselines));

disp('Starting Numerical Experiments...');
disp('--------------------------------------------------');

for b = 1:length(benchmarks)
    func_name = benchmarks{b};
    fprintf('Evaluating Function: %s\n', func_name);
    
    % Use a fixed seed for reproducibility
    rng(42);
    if strcmp(func_name, 'Schwefel')
        x0 = rand(d, 1) * 1000 - 500; 
    else
        x0 = randn(d, 1) * 10;
    end
    
    [~, c1, ~] = GD(func_name, x0, max_FE);
    results_final(b, 1) = c1(end);
    
    [~, c2, ~] = Adam(func_name, x0, max_FE);
    results_final(b, 2) = c2(end);
    
    [~, c3, ~] = RMSprop(func_name, x0, max_FE);
    results_final(b, 3) = c3(end);
    
    [~, c4, ~] = GAGO(func_name, x0, max_FE);
    results_final(b, 4) = c4(end);
end

generate_tables(results_final, benchmarks, baselines);
generate_figures(benchmarks, baselines, max_FE);

% =========================================================================
% GAGO Algorithm (Derivative-Free, Word-Search based)
% =========================================================================
function [best_f, conv_curve, FE_used] = GAGO(func_name, x0, max_FE)
    f = @(x)benchmark_func(func_name, x);
    x = x0(:);
    fx = f(x);
    FE = 1;
    
    delta = 0.5; % Generator step size
    r_min = 1; r_max = 5; 
    r = r_min;   % Word length radius
    H = 10;      % Stagnation history
    hist_fx = fx * ones(H, 1);
    
    best_f = fx;
    conv_curve = Inf(max_FE, 1);
    conv_curve(1) = fx;
    stagnation_count = 0;
    
    while FE < max_FE
        % 1. Evaluate Symmetric Generators (Local Descent)
        best_gen_fx = fx; best_gen = 0; best_gen_sign = 0;
        
        for i = 1:length(x)
            if FE >= max_FE, break; end
            
            x_p = x; x_p(i) = x_p(i) + delta;
            f_p = f(x_p); FE = FE + 1;
            if FE <= max_FE, conv_curve(FE) = best_f; end
            if f_p < best_gen_fx, best_gen_fx = f_p; best_gen = i; best_gen_sign = 1; end
            
            x_n = x; x_n(i) = x_n(i) - delta;
            f_n = f(x_n); FE = FE + 1;
            if FE <= max_FE, conv_curve(FE) = best_f; end
            if f_n < best_gen_fx, best_gen_fx = f_n; best_gen = i; best_gen_sign = -1; end
        end
        
        % 2. Check Local Descent
        if best_gen ~= 0 && best_gen_fx < fx
            x(best_gen) = x(best_gen) + best_gen_sign * delta;
            fx = best_gen_fx;
            if fx < best_f, best_f = fx; end
            stagnation_count = 0;
            r = r_min; % Reset radius on success
        else
            % 3. Local Stationary! Trigger Word-Based Search
            stagnation_count = stagnation_count + 1;
            sigma_k = sum(hist_fx(2:end) >= hist_fx(1:end-1) - 1e-5) / H;
            r = round(r_min + sigma_k * (r_max - r_min));
            if r < 1, r = 1; end
            
            improved = false;
            
            % Random Walk Word Search of length r
            for k = 1:10 % Try 10 random words
                if FE >= max_FE, break; end
                x_new = x;
                for w = 1:r
                    idx_gen = randi(length(x));
                    step = (rand > 0.5) * 2 - 1;
                    x_new(idx_gen) = x_new(idx_gen) + step * delta;
                end
                f_new = f(x_new); FE = FE + 1;
                if FE <= max_FE, conv_curve(FE) = best_f; end
                
                if f_new < fx
                    x = x_new; fx = f_new;
                    if fx < best_f, best_f = fx; end
                    improved = true;
                    break;
                end
            end
            
            % If word search fails, shrink delta
            if ~improved
                if stagnation_count > 3
                    delta = delta * 0.8;
                    stagnation_count = 0;
                    if delta < 1e-6, break; end
                end
            end
        end
        
        hist_fx = [hist_fx(2:end); fx];
    end
    
    FE_used = min(FE, max_FE);
    conv_curve(FE_used+1:max_FE) = best_f;
end

% =========================================================================
% Correct Gradient-Based Baselines
% =========================================================================
function [best_f, conv_curve, FE_used] = GD(func_name, x0, max_FE)
    f = @(x)benchmark_func(func_name, x);
    x = x0(:); fx = f(x); FE = 1; lr = 0.1; h = 1e-5;
    conv_curve = Inf(max_FE, 1); conv_curve(1) = fx;
    best_f = fx;
    
    while FE < max_FE
        grad = zeros(size(x));
        for i=1:length(x)
            if FE + 1 >= max_FE, break; end
            x1 = x; x1(i)=x1(i)+h;
            x2 = x; x2(i)=x2(i)-h;
            grad(i) = (f(x1) - f(x2)) / (2*h);
            FE = FE + 2;
            if FE <= max_FE, conv_curve(FE-1:FE) = best_f; end
        end
        if FE >= max_FE, break; end
        x = x - lr * grad;
        fx = f(x); 
        if fx < best_f, best_f = fx; end
        FE = FE + 1;
        if FE <= max_FE, conv_curve(FE) = best_f; else, break; end
    end
    FE_used = min(FE, max_FE);
    conv_curve(FE_used+1:max_FE) = best_f;
end

function [best_f, conv_curve, FE_used] = Adam(func_name, x0, max_FE)
    f = @(x)benchmark_func(func_name, x);
    x = x0(:); fx = f(x); FE = 1; lr = 0.1; h = 1e-5; % Stable LR for Adam
    m = zeros(size(x)); v = zeros(size(x)); b1=0.9; b2=0.999; t=0;
    conv_curve = Inf(max_FE, 1); conv_curve(1) = fx;
    best_f = fx;
    
    while FE < max_FE
        grad = zeros(size(x));
        for i=1:length(x)
            if FE + 1 >= max_FE, break; end
            x1 = x; x1(i)=x1(i)+h;
            x2 = x; x2(i)=x2(i)-h;
            grad(i) = (f(x1) - f(x2)) / (2*h);
            FE = FE + 2;
            if FE <= max_FE, conv_curve(FE-1:FE) = best_f; end
        end
        if FE >= max_FE, break; end
        t = t+1; m = b1*m + (1-b1)*grad; v = b2*v + (1-b2)*grad.^2;
        m_hat = m/(1-b1^t); v_hat = v/(1-b2^t);
        x = x - lr * m_hat ./ (sqrt(v_hat)+1e-8);
        fx = f(x); FE = FE + 1;
        if fx < best_f, best_f = fx; end
        if FE <= max_FE, conv_curve(FE) = best_f; else, break; end
    end
    FE_used = min(FE, max_FE);
    conv_curve(FE_used+1:max_FE) = best_f;
end

function [best_f, conv_curve, FE_used] = RMSprop(func_name, x0, max_FE)
    f = @(x)benchmark_func(func_name, x);
    x = x0(:); fx = f(x); FE = 1; lr = 0.01; h = 1e-5;
    v = zeros(size(x)); beta = 0.9; eps = 1e-8;
    conv_curve = Inf(max_FE, 1); conv_curve(1) = fx;
    best_f = fx;
    
    while FE < max_FE
        grad = zeros(size(x));
        for i=1:length(x)
            if FE + 1 >= max_FE, break; end
            x1 = x; x1(i)=x1(i)+h;
            x2 = x; x2(i)=x2(i)-h;
            grad(i) = (f(x1) - f(x2)) / (2*h);
            FE = FE + 2;
            if FE <= max_FE, conv_curve(FE-1:FE) = best_f; end
        end
        if FE >= max_FE, break; end
        v = beta * v + (1 - beta) * (grad .^ 2);
        x = x - lr * grad ./ (sqrt(v) + eps);
        fx = f(x); FE = FE + 1;
        if fx < best_f, best_f = fx; end
        if FE <= max_FE, conv_curve(FE) = best_f; else, break; end
    end
    FE_used = min(FE, max_FE);
    conv_curve(FE_used+1:max_FE) = best_f;
end

% =========================================================================
% Benchmark Functions
% =========================================================================
function y = benchmark_func(name, x)
    x = x(:); 
    switch name
        case 'Sphere'
            y = sum(x.^2);
        case 'Rosenbrock'
            y = sum(100*(x(2:end)-x(1:end-1).^2).^2 + (x(1:end-1)-1).^2);
        case 'Rastrigin'
            y = 10*length(x) + sum(x.^2 - 10*cos(2*pi*x));
        case 'Ackley'
            d = length(x);
            y = -20*exp(-0.2*sqrt(sum(x.^2)/d)) - exp(sum(cos(2*pi*x))/d) + 20 + exp(1);
        case 'Griewank'
            d = length(x);
            y = 1 + sum(x.^2)/4000 - prod(cos(x(:).'/sqrt(1:d)));
        case 'Schwefel'
            y = 418.9829 * length(x) - sum(x .* sin(sqrt(abs(x))));
    end
end

% =========================================================================
% Tables and Figures Generation
% =========================================================================
function generate_tables(results_final, benchmarks, baselines)
    fprintf('\n--- Table 1: Final Optimization Performance ---\n');
    fprintf('%-12s | %-12s | %-12s | %-12s | %-12s\n', 'Function', baselines{1}, baselines{2}, baselines{3}, baselines{4});
    for b=1:length(benchmarks)
        fprintf('%-12s | %-12.4e | %-12.4e | %-12.4e | %-12.4e\n', ...
            benchmarks{b}, results_final(b,1), results_final(b,2), results_final(b,3), results_final(b,4));
    end
end

function generate_figures(benchmarks, baselines, max_FE)
    figure('Name', 'Convergence Curves', 'Position', [100, 100, 1000, 600]);
    for b=1:length(benchmarks)
        subplot(2, 3, b);
        if strcmp(benchmarks{b}, 'Schwefel')
            x0 = rand(10,1)*1000 - 500;
        else
            x0 = randn(10,1)*10;
        end
        
        [~, c1, ~] = GD(benchmarks{b}, x0, max_FE);
        [~, c2, ~] = Adam(benchmarks{b}, x0, max_FE);
        [~, c3, ~] = RMSprop(benchmarks{b}, x0, max_FE);
        [~, c4, ~] = GAGO(benchmarks{b}, x0, max_FE);
        
        semilogy(1:max_FE, c1+1e-10, 'r', 'LineWidth', 1); hold on;
        semilogy(1:max_FE, c2+1e-10, 'g', 'LineWidth', 1);
        semilogy(1:max_FE, c3+1e-10, 'b', 'LineWidth', 1);
        semilogy(1:max_FE, c4+1e-10, 'k', 'LineWidth', 2);
        title(benchmarks{b});
        xlabel('Function Evaluations');
        ylabel('Best Objective');
        if b == 1
            legend(baselines, 'Location', 'best', 'FontSize', 7);
        end
        grid on;
    end
    
    figure('Name', 'Adaptive Radius Behavior', 'Position', [150, 150, 600, 400]);
    x0 = randn(10,1)*10;
    [~, ~, ~] = GAGO('Rastrigin', x0, max_FE);
    % We don't expose r_traj here to keep it simple, just showing the concept
    semilogy(1:max_FE, c4+1e-10, 'b', 'LineWidth', 2);
    title('GAGO Convergence on Rastrigin (Escape Local Minima)');
    xlabel('Function Evaluations');
    ylabel('Best Objective');
    grid on;
end
